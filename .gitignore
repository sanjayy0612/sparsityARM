__pycache__/
.DS_Store
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# Local model downloads and checkpoints.
models/

# Benchmark output is reproducible and should remain local. Keep the directory.
benchmarks/results/*.json
benchmarks/results/*.log
benchmarks/results/*.npz
!benchmarks/results/.gitkeep

# Experiment artifacts: retain manifests, metrics, summaries and provenance;
# keep raw arrays, per-case logs and generated working-tree snapshots local.
research/results/**/*.npz
research/results/**/*.log
research/results/**/working-tree.patch
# Regenerable, row-level experiment data can be large.  Keep its manifest,
# aggregate, and summary in git; the manifest records the raw file hash.
research/results/**/metrics.csv
research/results/**/per_example.jsonl
research/results/**/sources/
research/data/**/*.parquet
research/data/**/*.jsonl
research/data/**/*.npz
research/data/**/*.gguf

# External runtime build trees are reproducible from the pinned submodule.
third_party/llama.cpp/build-arm-sparse/
